# ─── Database (Neon) ──────────────────────────────────────────────────────────
# Neon gives you two connection strings. They are NOT interchangeable.
#
#   DATABASE_URL  pooled   — host contains "-pooler". Used by the app at runtime
#                            (lib/db.ts -> @prisma/adapter-pg). This is what prevents
#                            connection exhaustion when serverless functions cold-start.
#
#   DIRECT_URL    unpooled — no "-pooler" in the host. Used by the Prisma CLI for
#                            migrations (prisma.config.ts). PgBouncer transaction mode
#                            cannot execute DDL, so migrations must bypass the pooler.
#
# Prisma 7 removed `directUrl` from the schema; the split now lives in prisma.config.ts.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/booking?sslmode=verify-full"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/booking?sslmode=verify-full"

# ─── Auth.js ──────────────────────────────────────────────────────────────────
# Generate with:  npx auth secret     (or)     openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# The sending domain must have SPF, DKIM and DMARC configured or confirmations land
# in spam — which for a booking system is a product failure, not an infra detail.
# Start the DNS records on day one; propagation takes hours. [GAP B14]
RESEND_API_KEY=""
EMAIL_FROM="Bookings <bookings@yourdomain.com>"

# ─── Rate limiting (Upstash Redis) ────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Cron ─────────────────────────────────────────────────────────────────────
# Shared secret compared with a timing-safe check on /api/cron/*.
CRON_SECRET=""

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
