{
  "name": "booking-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:verify": "tsx --env-file=.env scripts/verify-constraints.ts",
    "db:verify-flow": "tsx --env-file=.env scripts/verify-booking-flow.ts",
    "db:verify-manage": "tsx --env-file=.env scripts/verify-manage-flow.ts",
    "db:verify-admin": "tsx --env-file=.env scripts/verify-admin.ts",
    "db:verify-cron": "tsx --env-file=.env scripts/verify-cron.ts",
    "db:bench": "tsx --env-file=.env scripts/bench-availability.ts",
    "db:queries": "tsx --env-file=.env scripts/count-queries.ts"
  },
  "//": "There is deliberately no `db:push` script. `prisma db push` would drop the exclusion constraint and the time-off trigger, which exist only in hand-written migration SQL. See docs/GAP-ANALYSIS.md [C10].",
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@node-rs/argon2": "^2.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-email/components": "^1.0.12",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.22.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}

